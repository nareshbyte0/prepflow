# Copy this file to .env. Replace all example values before production.
MONGODB_URI=mongodb://127.0.0.1:27017/prepflow
# Existing projects using `mongodb=` are supported too, but MONGODB_URI is preferred.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CLIENT_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5000
PORT=5000
# Production email uses Resend. In development, verification/reset links print in the API log.
RESEND_API_KEY=
EMAIL_FROM=Prepflow <no-reply@example.com>
# Optional error reporting webhook. Send only to an HTTPS endpoint you control.
ERROR_WEBHOOK_URL=
ERROR_WEBHOOK_TOKEN=
# Optional: only if your local DNS blocks MongoDB Atlas SRV records.
# DNS_SERVERS=1.1.1.1,8.8.8.8
